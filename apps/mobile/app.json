{
  "expo": {
    "name": "Free To Go",
    "slug": "freetogo",
    "scheme": "freetogo",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "fi.freetogo.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Kauppiaat ottavat kameralla tuoreen kuvan tarjolla olevasta ruoasta ja skannaavat noutokoodit.",
        "NSLocationWhenInUseUsageDescription": "Näytämme lähimmät ilmaiset ruokatarjoukset. Sijaintia ei seurata taustalla."
      }
    },
    "android": {
      "package": "fi.freetogo.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Kauppiaat ottavat kameralla tuoreen kuvan tarjolla olevasta ruoasta ja skannaavat noutokoodit.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Kauppiaat ottavat kameralla tuoreen kuvan tarjolla olevasta ruoasta.",
          "photosPermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Näytämme lähimmät ilmaiset ruokatarjoukset. Sijaintia ei seurata taustalla."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6B5FEE"
        }
      ],
      "./plugins/withLightAppearance"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "backgroundColor": "#FFFFFF"
  }
}
